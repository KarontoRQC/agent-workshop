FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5178,http://localhost:5178,http://127.0.0.1:5188,http://localhost:5188
DATABASE_URL=postgresql://agent_workshop:agent_workshop@127.0.0.1:54329/agent_workshop
AGENT_AVATAR_DIR=../frontend/src/assets/agent-avatars
AGENT_STATIC_AVATAR_DIR=../frontend/public/agent-avatars
AGENT_STATIC_AVATAR_BASE_URL=/agent-avatars

# Required outside tests. Generate at least 32 random bytes and keep it private.
APP_SIGNING_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
API_SESSION_TTL_SECONDS=43200
CHAT_MESSAGE_MAX_CHARS=8000
ENABLE_ECHO_ENDPOINT=0

CHAT_PROVIDER=longcat
CHAT_CONFIG_FALLBACK=local
COZE_API_TOKEN=your_coze_api_token
COZE_BOT_ID=7652282276604756003
COZE_ROUTE_PLANNER_BOT_ID=7655970825086074920
COZE_RECOMMENDER_BOT_ID=7652585242385006626
COZE_USER_ID=your_coze_user_id
COZE_CHAT_URL=https://api.coze.cn/v3/chat
COZE_CONNECT_TIMEOUT=10
COZE_READ_TIMEOUT=300

# OpenAI-compatible LongCat provider.
LONGCAT_API_KEY=your_longcat_api_key
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-2.0
LONGCAT_MAX_TOKENS=3000
# Disable model-side reasoning so structured XML starts streaming immediately.
LONGCAT_THINKING=disabled
LONGCAT_TEMPERATURE=0.2
LONGCAT_SSE_CHUNK_SIZE=64
# Maximum silence while waiting for response headers or the next stream chunk.
LONGCAT_STREAM_READ_TIMEOUT=4
# Retry only transient failures that happen before response headers arrive.
LONGCAT_REQUEST_RETRIES=0
LONGCAT_RETRY_BACKOFF=0.25
# Keep subsequent classroom requests responsive while the provider is unstable.
LONGCAT_CIRCUIT_BREAKER_SECONDS=20

# Optional prompt path overrides.
# ROUTE_PLANNER_PROMPT_PATH=backend/prompts/knowledge_graph_agent.txt
# RECOMMENDER_PROMPT_PATH=backend/prompts/recommended_agent.txt

# Optional: override the recommender candidate set. Leave unset to load linked agents from data/source_agents_full.json.
# COZE_AGENT_NAMES=帝王竞技场,第一性原理挖掘,①战略专家

# TTS is Edge-only. Local/Piper model environment variables are intentionally ignored.
EDGE_TTS_EXE=edge-tts
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_TIMEOUT=25
